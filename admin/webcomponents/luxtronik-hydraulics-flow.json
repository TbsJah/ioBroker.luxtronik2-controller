{
	"manifestVersion": 1,
	"tag": "luxtronik-hydraulics-flow",
	"module": "./luxtronik-hydraulics-flow.js",
	"name": {
		"en": "Luxtronik Hydraulics & Energy Flow",
		"de": "Luxtronik Hydraulik- & Energiefluss"
	},
	"size": {
		"width": 560,
		"height": 330
	},
	"settings": {
		"type": "panel",
		"items": {
			"instance": {
				"type": "instance",
				"adapter": "luxtronik2-controller",
				"label": {
					"en": "Adapter instance",
					"de": "Adapter-Instanz"
				}
			},
			"title": {
				"type": "text",
				"default": "Hydraulik & Energiefluss",
				"label": {
					"en": "Title",
					"de": "Titel"
				}
			},
			"showControls": {
				"type": "checkbox",
				"default": true,
				"label": {
					"en": "Show ZIP & Hot Water buttons",
					"de": "ZIP- & Aufheizen-Buttons anzeigen"
				}
			}
		}
	}
}
