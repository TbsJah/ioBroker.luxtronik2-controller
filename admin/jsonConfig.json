						"text": {
							"en": "Please ensure you fill in ALL default values correctly below. Empty or wrong values can disrupt your heating system!",
							"de": "Bitte trage unbedingt alle untenstehenden Standardwerte korrekt für deine Anlage ein. Leere oder falsche Werte stören den regulären Heizbetrieb!"
						},
