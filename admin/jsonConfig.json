			},
			"icon": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath fill='currentColor' d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10s10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z'/%3E%3C/svg%3E",
			"items": {
				"informationIdle": {
					"type": "staticText",
					"text": {
						"en": "To prevent EEPROM/flash wear on your Luxtronik controller, parameters are only updated during active optimizations. Once the heat pump returns to idle, all modified parameters are automatically reverted to your defined default values below to ensure a safe operating state.",
						"de": "Um den internen Flash-Speicher der Luxtronik zu schonen, werden Schreibzugriffe nur während aktiver Optimierungen (z.B. Heiztakt) ausgeführt. Das Erzwingen der Vorgabewerte im Leerlauf (Standby) stellt sicher, dass die Anlage danach immer in einen sauberen Ausgangszustand zurückkehrt."
					},
					"style": { "height": "80px" },
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				},
				"idle_defaults_aktiv": {
					"type": "checkbox",
					"label": { "en": "Force default values during idle", "de": "Standardwerte im Leerlauf erzwingen" },
					"default": false,
					"confirm": {
